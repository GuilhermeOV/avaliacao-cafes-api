{
  "info": {
    "name": "API Avaliacao de Cafes Locais",
    "description": "Execute 'Login' primeiro: o token e salvo em {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081/cafes/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "cafeId",
      "value": "1"
    },
    {
      "key": "reviewId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registrar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Lima\",\n  \"email\": \"ana@email.com\",\n  \"senha\": \"abc123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guilherme@email.com\",\n  \"senha\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cafes",
      "item": [
        {
          "name": "Listar cafes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes"
              ]
            }
          }
        },
        {
          "name": "Filtrar por bairro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes?bairro=Centro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes"
              ],
              "query": [
                {
                  "key": "bairro",
                  "value": "Centro"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por tipo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes?tipo=cold brew",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "cold brew"
                }
              ]
            }
          }
        },
        {
          "name": "Ranking por media",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes?ordenar=media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes"
              ],
              "query": [
                {
                  "key": "ordenar",
                  "value": "media"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes/{{cafeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "{{cafeId}}"
              ]
            }
          }
        },
        {
          "name": "Reviews do cafe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes/{{cafeId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "{{cafeId}}",
                "reviews"
              ]
            }
          }
        },
        {
          "name": "Criar cafe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cafes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Café Aroma\",\n  \"endereco\": \"Rua A, 1\",\n  \"bairro\": \"Jardim\",\n  \"tipoCafePrincipal\": \"Cold Brew\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cafeId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar cafe (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cafes/{{cafeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "{{cafeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Café Aroma Premium\",\n  \"endereco\": \"Rua A, 10\",\n  \"bairro\": \"Jardim\",\n  \"tipoCafePrincipal\": \"cold brew\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Atualizar parcial (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cafes/{{cafeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "{{cafeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bairro\": \"Centro\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Excluir cafe",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes/{{cafeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "{{cafeId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Listar reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            }
          }
        },
        {
          "name": "Reviews por cafe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reviews?cafeId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ],
              "query": [
                {
                  "key": "cafeId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar review",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{reviewId}}"
              ]
            }
          }
        },
        {
          "name": "Criar review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cafeId\": {{cafeId}},\n  \"notaBebida\": 5,\n  \"notaAmbiente\": 4,\n  \"notaAtendimento\": 3,\n  \"comentario\": \"Ótimo café!\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('reviewId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar review (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{reviewId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notaBebida\": 4,\n  \"notaAmbiente\": 4,\n  \"notaAtendimento\": 4,\n  \"comentario\": \"Mudei de ideia.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Atualizar review (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{reviewId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notaAtendimento\": 5\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Excluir review",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{reviewId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Erros (demonstracao)",
      "item": [
        {
          "name": "401 - sem token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cafes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"X\"\n}"
            }
          }
        },
        {
          "name": "400 - nota invalida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cafeId\": 1,\n  \"notaBebida\": 9,\n  \"notaAmbiente\": 4,\n  \"notaAtendimento\": 4\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "404 - cafe inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "999"
              ]
            }
          }
        },
        {
          "name": "409 - excluir cafe com reviews",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cafes/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cafes",
                "1"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}